# Sao chép thành /etc/hangmu/hangmu.env (quyền 600, chủ sở hữu root) rồi chỉnh.
PORT=8787
STATIC_DIR=/opt/hangmu/dist
DATA_DIR=/var/lib/hangmu
LOG_LEVEL=info
CAPACITY=500
BOTS=8
# Đứng sau Caddy/nginx trên cùng máy: bật, và để cổng 8787 chỉ nghe nội bộ (tường lửa chặn từ ngoài).
TRUST_PROXY=1
ALLOWED_ORIGINS=https://hang.example.com
# Tạo bằng: openssl rand -hex 24   (để trống = tắt hoàn toàn API quản trị)
ADMIN_TOKEN=
