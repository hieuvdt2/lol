{
  "name": "hangmu-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/dev.mjs",
    "room": "node server/room.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "hangmu": "node server/hangmu-server.mjs",
    "test": "node scripts/test-all.mjs",
    "test:e2e": "node --test --test-force-exit --test-timeout=420000 --experimental-strip-types --no-warnings --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "perf:actors": "node --experimental-strip-types --no-warnings tests/perf/actors.mjs",
    "perf:network": "node --experimental-strip-types --no-warnings tests/perf/network.mjs",
    "perf:accuracy": "node --experimental-strip-types --no-warnings tests/perf/accuracy.mjs",
    "lan": "node scripts/lan.mjs",
    "crowd": "node scripts/crowd.mjs",
    "perf:soak": "node --experimental-strip-types --no-warnings tests/perf/soak.mjs",
    "test:fast": "node --test --test-force-exit --test-timeout=60000 --experimental-strip-types --no-warnings \"tests/unit/*.test.mjs\" \"tests/server/*.test.mjs\" \"tests/client/*.test.mjs\""
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "playwright-core": "^1.65.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
